# Copiar a .env y completar. Nunca comitear .env.
DATABASE_URL=postgresql+psycopg://moneyplease:moneyplease@localhost:5432/moneyplease
# JSearch (RapidAPI). Vacío = conector desactivado.
JSEARCH_API_KEY=
# Gmail: credenciales OAuth de Google Cloud y token generado con `gmail-auth`
GMAIL_CREDENTIALS_PATH=secrets/gmail_credentials.json
GMAIL_TOKEN_PATH=secrets/gmail_token.json
GMAIL_LABEL=Empleo/Alertas
